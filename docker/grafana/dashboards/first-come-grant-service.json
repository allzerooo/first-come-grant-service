{
  "id": null,
  "uid": "first-come-grant-service",
  "title": "First Come Grant Service",
  "tags": ["first-come-grant"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "RPS (Requests Per Second)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri!=\"UNKNOWN\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count[1m])) * 100",
          "legendFormat": "5xx error %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Avg Response Time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{uri!=\"UNKNOWN\"}[1m]) / rate(http_server_requests_seconds_count{uri!=\"UNKNOWN\"}[1m]) * 1000",
          "legendFormat": "avg {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Max Response Time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "http_server_requests_seconds_max{uri!=\"UNKNOWN\"} * 1000",
          "legendFormat": "max {{uri}}"
        }
      ]
    }
  ]
}
